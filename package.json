{
  "name": "fpasoterm-plugins",
  "version": "0.0.1",
  "private": true,
  "description": "Ports-style community plugins for fpasoterm.",
  "license": "MIT",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "npm run check:syntax && npm test",
    "check:syntax": "tsc --noEmit --project tsconfig.json",
    "test": "npm run build --silent && node dist/tests.js",
    "scan:secrets": "npm run build --silent && node dist/security/scan-secrets.js",
    "audit:prod": "npm audit --omit=dev",
    "security": "npm run scan:secrets && npm run audit:prod",
    "ports": "npm run build --silent && node dist/ports.js",
    "index": "npm run ports -- index --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
